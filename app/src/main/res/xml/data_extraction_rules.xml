<?xml version="1.0" encoding="utf-8"?>
<!--
  exclude-activity / data-extraction rules. The transient session seed is Keystore-wrapped
  and the session record holds no secret that should ever leave the device, so BumpPay opts
  out of cloud backup and device transfer entirely rather than trying to be selective.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
